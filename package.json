{
  "name": "@laddro/career-mcp",
  "version": "0.3.3",
  "mcpName": "com.laddro/career",
  "description": "MCP server for the Laddro Career API",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "laddro-career-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "changeset": "changeset",
    "dev": "tsc --watch",
    "release": "npm test && changeset publish",
    "test": "npm run build && node --test test/*.test.mjs",
    "version": "changeset version && node scripts/sync-version-metadata.mjs && npm install --package-lock-only",
    "start": "node dist/server.js",
    "start:stdio": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "laddro",
    "career",
    "resume",
    "ai-agent"
  ],
  "author": "Laddro <support@laddro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laddro-app/laddro-career-mcp"
  },
  "homepage": "https://docs.laddro.com",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@laddro/career-sdk": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
