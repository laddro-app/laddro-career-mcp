{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.laddro/career",
  "title": "Laddro Career",
  "description": "Tailor resumes, generate cover letters, render CVs as PDF, and browse 22+ templates.",
  "version": "0.3.1",
  "websiteUrl": "https://docs.laddro.com/docs/mcp",
  "repository": {
    "url": "https://github.com/laddro-app/laddro-career-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@laddro/career-mcp",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LADDRO_API_KEY",
          "description": "Your Laddro Career API key from console.laddro.com",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.laddro.com/mcp"
    }
  ]
}
